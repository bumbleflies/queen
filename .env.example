# Google OAuth (Drive scope only — no Sheets scope; see plan Task 2)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Drive folder where filed invoice PDFs are uploaded (Task 5)
GOOGLE_DRIVE_INVOICES_FOLDER_ID=your-drive-folder-id

# valkey/redis for the Bull filing queue (Task 5). Unset → enqueue is a no-op.
# REDIS_URL=redis://valkey:6379

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_in_production

# Optional stricter sign-in allowlist (comma-separated). queen reuses the
# bumbleflies Google OAuth client, so the consent screen is already the access
# boundary; leave empty to allow any authenticated Google user.
# ALLOWED_EMAILS=

# Comma-separated admin emails. Falls back to ALLOWED_EMAILS; if both are unset,
# every authenticated user is an admin (bumbleflies-only deployments).
# Promotions apply on the user's next login.
# ADMIN_EMAILS=you@example.de

# Bearer token for service-to-service calls (ext.* API, cron). (generate with: openssl rand -hex 32)
QUEEN_SERVICE_TOKEN=change_me_in_production

# Firefly III (GLS bank account sync, Task 6). PAT = personal access token.
FIREFLY_URL=http://firefly:8080
FIREFLY_PAT=change_me_in_production
FIREFLY_GLS_ACCOUNT_ID=1
# First sync window start (YYYY-MM-DD); later runs look back 7 days from the last run.
QUEEN_BANK_START=2025-01-01

# MongoDB (leave unset to use in-memory server for dev)
# MONGO_URI=mongodb://localhost:27017/queen

# Production MongoDB (set this when running with Docker Compose)
# MONGO_URI=mongodb://mongo:27017/queen

# Force-disable MongoDB transactions (useful for standalone instances)
# MONGODB_DISABLE_TRANSACTIONS=true

NODE_ENV=development
PORT=3000
