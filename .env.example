# Google OAuth (Drive scope only — no Sheets scope; see plan Task 2)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_in_production

# MongoDB (leave unset to use in-memory server for dev)
# MONGO_URI=mongodb://localhost:27017/queen

# Production MongoDB (set this when running with Docker Compose)
# MONGO_URI=mongodb://mongo:27017/queen

# Force-disable MongoDB transactions (useful for standalone instances)
# MONGODB_DISABLE_TRANSACTIONS=true

NODE_ENV=development
PORT=3000
